# ─────────────────────────────────────────────────────────────────────────────
# automation-pos-apps — default configuration & credentials
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Execution flags ───────────────────────────────────────────────────────────
ENV=uat
HEADLESS=false
WORKERS=1
ALLURE=false
LOG_LEVEL=INFO

# ── UAT credentials ───────────────────────────────────────────────────────────
UAT_VALID_USER=uat_user@example.com
UAT_VALID_PASS=uat_password
UAT_INVALID_USER=wrong@example.com
UAT_INVALID_PASS=wrongpassword

# ── Staging credentials ───────────────────────────────────────────────────────
STAGING_VALID_USER=staging_user@example.com
STAGING_VALID_PASS=staging_password
STAGING_INVALID_USER=wrong@example.com
STAGING_INVALID_PASS=wrongpassword

# ── API tokens (optional) ─────────────────────────────────────────────────────
API_TOKEN=
